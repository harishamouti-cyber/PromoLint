// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model OfferCheck {
  id                     String   @id @default(uuid())
  shop                   String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  status                 String   // "READY" | "REVIEW" | "BLOCKED"
  triggerProductId       String
  triggerProductTitle    String
  triggerVariantId       String
  triggerVariantTitle    String
  offeredProductId       String
  offeredProductTitle    String
  offeredVariantId       String
  offeredVariantTitle    String
  offeredProductImageUrl String?
  discountType           String   // "PERCENTAGE" | "FIXED_AMOUNT"
  discountValue          Float
  currencyCode           String   @default("USD")
  currentPrice           Float
  unitCost               Float?
  discountedPrice        Float
  estimatedGrossProfit   Float?
  estimatedGrossMargin   Float?
  locationId             String
  locationName           String
  inventoryQuantity      Int?
  inventoryTracked       Boolean  @default(true)
  warnings               String   // JSON stringified array of Warning objects
  assumptions            String

  @@index([shop, createdAt])
}

model PromoLintSettings {
  id                  String   @id @default(uuid())
  shop                String   @unique
  defaultLocationId   String?
  defaultLocationName String?
  minStockThreshold   Int      @default(5)
  minMarginThreshold  Float    @default(20.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

